# Bit-Trade v3.0 Simplified - Environment Configuration
# Copy this file to .env and fill in your API keys

# Groq API (REQUIRED) - Get from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Binance API (REQUIRED for demo trading) - Get from https://testnet.binance.vision/
BINANCE_API_KEY=your_binance_testnet_api_key
BINANCE_API_SECRET=your_binance_testnet_secret

# Optional: Supabase for result storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# System Configuration
USE_Q_LEARNING=true
GROQ_MODEL_ROTATION=round_robin